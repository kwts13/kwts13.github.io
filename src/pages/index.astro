---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../site';

const all = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = all.slice(0, 3);
---
<Base>
  <section class="hero">
    <p class="eyebrow loc">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" /></svg>
      {site.location}
    </p>
    <h1>Hello, I’m {site.name}.<br /><span class="accent">{site.tagline}</span></h1>
    <p class="copy">{site.about[0]}</p>
    
  </section>

  <hr class="rule" />
  <div class="section-head">
    <h2>Latest</h2>
    <a href="/blog">All posts</a>
  </div>
  <PostList posts={posts} total={all.length} />
</Base>
