---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---
<Base title="Contact" description="Get in touch about business analysis, product, or new opportunities.">
  <p class="eyebrow">Contact</p>
  <h1>Let’s talk.</h1>
  <p class="copy">I’m happy to chat about business analysis, product, and new opportunities. Send a message and I’ll get back to you.</p>

  <form class="form" id="contact-form" action={site.formEndpoint || undefined} method="POST" novalidate>
    <label>
      <span>Name</span>
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label>
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <label>
      <span>Message</span>
      <textarea name="message" rows="6" required></textarea>
    </label>
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
    <div class="form-foot">
      <button type="submit" class="submit">Send message</button>
      <p class="status" id="form-status" role="status" aria-live="polite"></p>
    </div>
  </form>

</Base>

<script define:vars={{ endpoint: site.formEndpoint }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const btn = form.querySelector('.submit');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.className = 'status';
    if (!form.checkValidity()) { status.textContent = 'Please fill in every field with a valid email.'; status.classList.add('err'); return; }
    if (!endpoint) { status.textContent = 'The form isn’t connected yet.'; status.classList.add('err'); return; }
    btn.disabled = true; status.textContent = 'Sending…';
    try {
      const res = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error();
      form.reset(); status.textContent = 'Thanks, message sent.'; status.classList.add('ok');
    } catch {
      status.textContent = 'Something went wrong. Please try again in a bit.'; status.classList.add('err');
    }
    btn.disabled = false;
  });
</script>
